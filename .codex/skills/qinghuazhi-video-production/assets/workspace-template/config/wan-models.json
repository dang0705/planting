{
  "version": 1,
  "routing": {
    "defaultMode": "auto",
    "pinScope": "lane",
    "routingStateFile": "runtime/wan-routing-state.json",
    "quotaLedgerFile": "runtime/wan-quota-ledger.json",
    "lanes": {
      "dialogue": {
        "autoOrder": [
          "wan27-snapshot-free",
          "wan27-latest-free",
          "wan26-free",
          "wan26-flash-paid"
        ],
        "allowForced": true
      },
      "silentVisual": {
        "autoOrder": [
          "wan26-flash-paid"
        ],
        "allowForced": false
      }
    },
    "maxAutomaticFallbacks": 6,
    "freeQuotaExhaustedCodes": [
      "AllocationQuota.FreeTierOnly"
    ],
    "freeTierStopMustBeEnabledInConsole": true,
    "notes": [
      "person_dialogue 始终经过 VideoRetalk；免费有声模型的 driving_audio 仅作为视觉表演指导。",
      "免费额度耗尽后 dialogue lane 最终回退到 wan2.6-i2v-flash silent + VideoRetalk。",
      "plant / person_voiceover 使用 silentVisual lane，当前固定 wan2.6-i2v-flash audio=false。"
    ]
  },
