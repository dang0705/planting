{
  "meta": {
    "name": "uni-ui-figma-component-mapper",
    "version": "1.0.0",
    "language": "zh-CN",
    "purpose": "Map Figma UI signals to official DCloud uni-ui components for uni-app/Vue implementation.",
    "defaultPlatformPriority": [
      "微信小程序",
      "H5",
      "App"
    ]
  },
  "components": [
    {
      "name": "uni-badge",
      "cn": "数字角标",
      "doc": "https://uniapp.dcloud.net.cn/component/uniui/uni-badge.html",
      "category": "状态/提示",
      "codeBlock": "uBadge",
      "useWhen": "图标、列表项、宫格、按钮右上出现数字、红点、99+、未读数、购物车数量。",
      "figmaSignals": [
        "小圆点",
        "右上角数字",
        "红色角标",
        "消息数",
        "未读",
        "99+",
        "购物车数量",
        "badge"
      ],
      "props": [
        "text",
        "type",
        "size",
        "is-dot",
        "max-num",
        "inverted",
        "absolute",
        "offset",
        "custom-style"
      ],
      "events": [
        "@click"
      ],
      "skeleton": "<uni-badge :text=\"count\" type=\"error\" absolute=\"rightTop\"><uni-icons type=\"chat\" size=\"24\" /></uni-badge>",
      "avoid": "纯文本标签不要用；用 uni-tag。只是状态色块不要用。nvue 不支持 absolute。"
    },
    {
      "name": "uni-breadcrumb",
      "cn": "面包屑",
      "doc": "https://uniapp.dcloud.net.cn/component/uniui/uni-breadcrumb.html",
      "category": "导航",
      "codeBlock": "uBreadcrumb",
      "useWhen": "页面顶部显示层级路径，可点击返回上级或任意祖先页面。多用于后台、管理页、PC/H5。",
      "figmaSignals": [
        "首页 / 分类 / 详情",
        "路径层级",
        "面包屑",
        "breadcrumb",
        "返回上级路径"
      ],
      "props": [
        "separator"
      ],
      "events": [],
      "skeleton": "<uni-breadcrumb separator=\"/\"><uni-breadcrumb-item v-for=\"r in routes\" :key=\"r.to\" :to=\"r.to\">{{ r.name }}</uni-breadcrumb-item></uni-breadcrumb>",
      "avoid": "移动端单页只需要返回按钮时优先用 nav-bar 或原生导航。"
    },
    {
      "name": "uni-calendar",
      "cn": "日历",
      "doc": "https://uniapp.dcloud.net.cn/component/uniui/uni-calendar.html",
      "category": "日期/选择",
      "codeBlock": "uCalendar",
      "useWhen": "展示整月日历、日期范围、打点标记、签到、预约、过去/未来日期选择。",
      "figmaSignals": [
        "月历",
        "日期格子",
        "日期范围",
        "打卡",
        "签到",
        "预约日期",
        "酒店日期",
        "calendar dots"
      ],
      "props": [
        "date",
        "start-date",
        "end-date",
        "insert",
        "range",
        "selected",
        "lunar",
        "clear-date"
      ],
      "events": [
        "@change",
        "@confirm",
        "@monthSwitch"
      ],
      "skeleton": "<uni-calendar :insert=\"false\" :range=\"true\" :selected=\"marks\" @confirm=\"onConfirm\" />",
      "avoid": "只选择单个日期/时间且不需要月历视图时，优先 uni-datetime-picker 或原生 picker。"
    },
    {
      "name": "uni-card",
      "cn": "卡片",
      "doc": "https://uniapp.dcloud.net.cn/component/uniui/uni-card.html",
      "category": "内容容器",
      "codeBlock": "uCard",
      "useWhen": "独立信息块：文章/商品/植物/诊断结果卡片，有标题、缩略图、摘要、操作区。",
      "figmaSignals": [
        "白色圆角卡片",
        "阴影卡片",
        "独立内容块",
        "封面图+标题",
        "作者时间",
        "card"
      ],
      "props": [
        "title",
        "sub-title",
        "extra",
        "thumbnail",
        "cover",
        "is-full",
        "is-shadow",
        "spacing",
        "margin"
      ],
      "events": [
        "@click"
      ],
      "skeleton": "<uni-card :title=\"title\" :sub-title=\"subtitle\" :thumbnail=\"thumb\" @click=\"openDetail\"><view>{{ summary }}</view></uni-card>",
      "avoid": "只是分组间距用 uni-group；重复简单列表行用 uni-list。APP-NVUE 安卓不支持阴影。"
    },
    {
      "name": "uni-collapse",
      "cn": "折叠面板",
      "doc": "https://uniapp.dcloud.net.cn/component/uniui/uni-collapse.html",
      "category": "内容容器/交互",
      "codeBlock": "uCollapse",
      "useWhen": "FAQ、详情字段、长说明、分类内容需要展开/收起。",
      "figmaSignals": [
        "展开收起",
        "手风琴",
        "FAQ",
        "箭头下拉",
        "长内容折叠",
        "collapse",
        "accordion"
      ],
      "props": [
        "accordion",
        "value",
        "show-animation"
      ],
      "events": [
        "@change"
      ],
      "skeleton": "<uni-collapse accordion><uni-collapse-item title=\"养护说明\"><view>{{ content }}</view></uni-collapse-item></uni-collapse>",
      "avoid": "小程序内容动态变化后需 resize；App 动画可能卡顿；uni-collapse-item 不要单独使用。"
    },
    {
      "name": "uni-combox",
      "cn": "组合框",
      "doc": "https://uniapp.dcloud.net.cn/component/uniui/uni-combox.html",
      "category": "表单/选择",
      "codeBlock": "uCombox",
      "useWhen": "既允许从候选项中选择，又允许手动输入的表单项。",
      "figmaSignals": [
        "输入+下拉建议",
        "可搜索输入框",
        "城市候选",
        "自定义输入",
        "combo box",
        "autocomplete"
      ],
      "props": [
        "label",
        "labelWidth",
        "placeholder",
        "candidates",
        "emptyTips",
        "value"
      ],
      "events": [
        "@input"
      ],
      "skeleton": "<uni-combox label=\"城市\" :candidates=\"cityOptions\" placeholder=\"请选择或输入\" v-model=\"form.city\" />",
      "avoid": "不支持 nvue；纯下拉选择用 uni-data-select；多级选择用 uni-data-picker。"
    },
    {
      "name": "uni-countdown",
      "cn": "倒计时",
      "doc": "https://uniapp.dcloud.net.cn/component/uniui/uni-countdown.html",
      "category": "状态/时间",
      "codeBlock": "uCountDown",
      "useWhen": "活动结束、支付剩余时间、限时优惠、任务倒计时。",
      "figmaSignals": [
        "倒计时",
        "天 时 分 秒",
        "剩余时间",
        "限时",
        "countdown",
        "D:H:M:S"
      ],
      "props": [
        "day",
        "hour",
        "minute",
        "second",
        "show-day",
        "color",
        "background-color",
        "border-color"
      ],
      "events": [
        "@timeup"
      ],
      "skeleton": "<uni-countdown :show-day=\"false\" :hour=\"12\" :minute=\"30\" :second=\"0\" @timeup=\"onTimeup\" />",
      "avoid": "只是格式化展示一个日期，用 uni-dateformat。"
    },
    {
      "name": "uni-data-checkbox",
      "cn": "数据选择器",
      "doc": "https://uniapp.dcloud.net.cn/component/uniui/uni-data-checkbox.html",
      "category": "表单/选择",
      "codeBlock": "uDataCheckbox",
      "useWhen": "单选/多选候选项，样式可为普通、button、tag；需要和 uni-forms 校验配合。",
      "figmaSignals": [
        "单选",
        "多选",
        "复选框组",
        "胶囊选项",
        "tag 风格选项",
        "radio group",
        "checkbox group"
      ],
      "props": [
        "v-model",
        "localdata",
        "mode",
        "multiple",
        "min",
        "max",
        "selectedColor",
        "map"
      ],
      "events": [
        "@change"
      ],
      "skeleton": "<uni-data-checkbox v-model=\"form.light\" :localdata=\"lightOptions\" mode=\"tag\" @change=\"onChange\" />",
      "avoid": "选项很多或需要下拉时用 uni-data-select；级联层级用 uni-data-picker。样式高度定制时可能要自写。"
    },
    {
      "name": "uni-data-picker",
      "cn": "级联选择器",
      "doc": "https://uniapp.dcloud.net.cn/component/uniui/uni-data-picker.html",
      "category": "表单/选择",
      "codeBlock": "uDataPicker",
      "useWhen": "地址、省市区、植物分类、病虫害层级、无限层级级联，支持懒加载/本地/云端数据。",
      "figmaSignals": [
        "省市区",
        "多列选择",
        "级联",
        "分类选择",
        "地址选择",
        "picker columns",
        "cascader"
      ],
      "props": [
        "v-model",
        "localdata",
        "readonly",
        "clear-icon",
        "ellipsis",
        "popup-title",
        "map",
        "collection",
        "field",
        "where"
      ],
      "events": [
        "@change",
        "@nodeclick",
        "@popupopened",
        "@popupclosed"
      ],
      "skeleton": "<uni-data-picker v-model=\"form.region\" :localdata=\"regionTree\" popup-title=\"请选择地区\" @change=\"onRegionChange\" />",
      "avoid": "单层少量选项用 uni-data-checkbox 或 uni-data-select；不要为了普通枚举引入级联复杂度。"
    },
    {
      "name": "uni-data-select",
      "cn": "下拉框",
      "doc": "https://uniapp.dcloud.net.cn/component/uniui/uni-data-select.html",
      "category": "表单/选择",
      "codeBlock": "uDataSelect",
      "useWhen": "选项较多但只有单层，需下拉展示；可与 uni-forms 校验配合。",
      "figmaSignals": [
        "下拉框",
        "选择框",
        "select",
        "dropdown",
        "更多选项",
        "表单枚举"
      ],
      "props": [
        "v-model",
        "localdata",
        "clear",
        "placeholder",
        "placement",
        "multiple",
        "format"
      ],
      "events": [
        "@change"
      ],
      "skeleton": "<uni-data-select v-model=\"form.type\" :localdata=\"typeOptions\" placeholder=\"请选择类型\" @change=\"onTypeChange\" />",
      "avoid": "可输入可选择用 uni-combox；多级选择用 uni-data-picker；少量显性选项用 uni-data-checkbox。"
    },
    {
      "name": "uni-dateformat",
      "cn": "日期格式化",
      "doc": "https://uniapp.dcloud.net.cn/component/uniui/uni-dateformat.html",
      "category": "文本/时间",
      "codeBlock": "uDateformat",
      "useWhen": "把时间戳或日期字符串渲染成“刚刚、xx分钟前、yyyy/MM/dd”等文本。",
      "figmaSignals": [
        "发布时间",
        "刚刚",
        "分钟前",
        "日期文字",
        "更新时间",
        "date text",
        "relative time"
      ],
      "props": [
        "date",
        "format",
        "threshold"
      ],
      "events": [],
      "skeleton": "<uni-dateformat :date=\"item.createdAt\" format=\"yyyy-MM-dd hh:mm\" />",
      "avoid": "需要用户选择日期时不用它，改用 calendar/datetime-picker。"
    },
    {
      "name": "uni-datetime-picker",
      "cn": "日期选择器",
      "doc": "https://uniapp.dcloud.net.cn/component/uniui/uni-datetime-picker.html",
      "category": "日期/选择",
      "codeBlock": "uDatetimePicker",
      "useWhen": "表单中选择日期、日期时间、日期时间范围；需要时间戳输入/输出。",
      "figmaSignals": [
        "日期选择",
        "时间选择",
        "开始结束时间",
        "日期范围",
        "datetime picker",
        "range picker"
      ],
      "props": [
        "v-model",
        "type",
        "start",
        "end",
        "return-type",
        "rangeSeparator",
        "clear-icon"
      ],
      "events": [
        "@change",
        "@maskClick"
      ],
      "skeleton": "<uni-datetime-picker v-model=\"form.range\" type=\"datetimerange\" return-type=\"timestamp\" @change=\"onDateChange\" />",
      "avoid": "2.0 后不支持单独 type=time；单独时间选择用原生 picker。整月日历/打点用 uni-calendar。"
    },
    {
      "name": "uni-drawer",
      "cn": "抽屉",
      "doc": "https://uniapp.dcloud.net.cn/component/uniui/uni-drawer.html",
      "category": "弹层/导航",
      "codeBlock": "uDrawer",
      "useWhen": "侧滑菜单、筛选面板、右侧详情栏、侧边导航。",
      "figmaSignals": [
        "侧边栏",
        "从左/右滑出",
        "抽屉",
        "筛选面板",
        "drawer",
        "side panel"
      ],
      "props": [
        "mode",
        "width",
        "mask-click"
      ],
      "events": [
        "@change"
      ],
      "skeleton": "<uni-drawer ref=\"filterDrawer\" mode=\"right\" :mask-click=\"true\"><scroll-view scroll-y class=\"drawer-body\">...</scroll-view></uni-drawer>",
      "avoid": "普通居中/底部弹窗用 uni-popup；nvue 动态 width 不生效。"
    },
    {
      "name": "uni-easyinput",
      "cn": "增强输入框",
      "doc": "https://uniapp.dcloud.net.cn/component/uniui/uni-easyinput.html",
      "category": "表单/输入",
      "codeBlock": "uEasyinput",
      "useWhen": "表单输入框，需要边框、清除按钮、前后图标、密码、多行、校验联动。",
      "figmaSignals": [
        "输入框",
        "搜索外普通输入",
        "清除按钮",
        "前缀图标",
        "后缀图标",
        "密码",
        "textarea",
        "input"
      ],
      "props": [
        "v-model",
        "placeholder",
        "type",
        "clearable",
        "prefixIcon",
        "suffixIcon",
        "disabled",
        "maxlength",
        "trim"
      ],
      "events": [
        "@input",
        "@focus",
        "@blur",
        "@confirm",
        "@iconClick"
      ],
      "skeleton": "<uni-easyinput v-model=\"form.name\" placeholder=\"请输入名称\" prefixIcon=\"person\" @iconClick=\"onIconClick\" />",
      "avoid": "搜索栏用 uni-search-bar；数字步进用 uni-number-box；选择型输入不用 easyinput 伪装。"
    },
    {
      "name": "uni-fab",
      "cn": "悬浮按钮",
      "doc": "https://uniapp.dcloud.net.cn/component/uniui/uni-fab.html",
      "category": "操作入口",
      "codeBlock": "uFab",
      "useWhen": "页面角落固定主操作按钮，可展开多个快捷操作。",
      "figmaSignals": [
        "悬浮加号",
        "右下角按钮",
        "展开菜单",
        "floating action button",
        "FAB"
      ],
      "props": [
        "pattern",
        "content",
        "horizontal",
        "vertical",
        "direction",
        "popMenu"
      ],
      "events": [
        "@fabClick",
        "@trigger"
      ],
      "skeleton": "<uni-fab :pattern=\"fabPattern\" :content=\"fabActions\" horizontal=\"right\" vertical=\"bottom\" @trigger=\"onFabTrigger\" />",
      "avoid": "不要动态频繁改属性；展开项最多建议 4 个；展开菜单图标用图片路径更稳。"
    },
    {
      "name": "uni-fav",
      "cn": "收藏按钮",
      "doc": "https://uniapp.dcloud.net.cn/component/uniui/uni-fav.html",
      "category": "状态/操作",
      "codeBlock": "uFav",
      "useWhen": "收藏/取消收藏、喜欢/已喜欢的切换按钮。",
      "figmaSignals": [
        "收藏",
        "爱心",
        "星标",
        "喜欢",
        "favorite",
        "like toggle"
      ],
      "props": [
        "checked",
        "circle",
        "bgColor",
        "bgColorChecked",
        "fgColor",
        "fgColorChecked"
      ],
      "events": [
        "@click"
      ],
      "skeleton": "<uni-fav :checked=\"isFav\" circle @click=\"toggleFav\" />",
      "avoid": "评分用 uni-rate；普通图标按钮可用 button + uni-icons。"
    },
    {
      "name": "uni-file-picker",
      "cn": "文件选择上传",
      "doc": "https://uniapp.dcloud.net.cn/component/uniui/uni-file-picker.html",
      "category": "上传",
      "codeBlock": "uFilePicker",
      "useWhen": "选择/上传图片、视频、文件；图片宫格上传；表单附件上传。",
      "figmaSignals": [
        "上传图片",
        "添加照片",
        "上传文件",
        "九宫格图片",
        "附件",
        "camera upload",
        "file picker"
      ],
      "props": [
        "v-model",
        "file-mediatype",
        "file-extname",
        "limit",
        "mode",
        "auto-upload",
        "image-styles",
        "del-icon"
      ],
      "events": [
        "@select",
        "@progress",
        "@success",
        "@fail",
        "@delete"
      ],
      "skeleton": "<uni-file-picker v-model=\"images\" file-mediatype=\"image\" :limit=\"3\" mode=\"grid\" @select=\"onSelect\" />",
      "avoid": "不绑定服务空间时 autoUpload 默认 false 且不可改；文件选择只支持 H5 和微信小程序；微信用 wx.chooseMessageFile。"
    },
    {
      "name": "uni-forms",
      "cn": "表单",
      "doc": "https://uniapp.dcloud.net.cn/component/uniui/uni-forms.html",
      "category": "表单/校验",
      "codeBlock": "uForms",
      "related": [
        "uni-forms-item",
        "uni-easyinput",
        "uni-data-checkbox",
        "uni-group"
      ],
      "useWhen": "页面有多个字段、校验、错误提示、分组表单、提交。",
      "figmaSignals": [
        "表单",
        "必填星号",
        "错误提示",
        "输入项组",
        "提交表单",
        "form validation"
      ],
      "props": [
        "ref",
        "model",
        "rules",
        "label-position",
        "label-width",
        "validate-trigger"
      ],
      "events": [
        "validate",
        "submit via methods"
      ],
      "skeleton": "<uni-forms ref=\"formRef\" :model=\"form\" :rules=\"rules\"><uni-forms-item label=\"名称\" name=\"name\"><uni-easyinput v-model=\"form.name\" /></uni-forms-item></uni-forms>",
      "avoid": "每个 uni-forms-item 只放一个表单项；纯布局不要套 forms；分组视觉用 uni-group。"
    },
    {
      "name": "uni-goods-nav",
      "cn": "商品导航",
      "doc": "https://uniapp.dcloud.net.cn/component/uniui/uni-goods-nav.html",
      "category": "电商",
      "codeBlock": "uGoodsNav",
      "useWhen": "商品详情页底部固定“客服/店铺/购物车 + 加入购物车/立即购买”。",
      "figmaSignals": [
        "加入购物车",
        "立即购买",
        "底部商品操作栏",
        "客服 店铺 购物车",
        "goods nav",
        "buy bar"
      ],
      "props": [
        "options",
        "buttonGroup",
        "fill"
      ],
      "events": [
        "@click",
        "@buttonClick"
      ],
      "skeleton": "<uni-goods-nav :options=\"navOptions\" :buttonGroup=\"buyButtons\" @click=\"onNavClick\" @buttonClick=\"onBuyClick\" />",
      "avoid": "普通底部 tabbar 不用它；非电商主操作条更适合自定义或 button 组合。"
    },
    {
      "name": "uni-grid",
      "cn": "宫格",
      "doc": "https://uniapp.dcloud.net.cn/component/uniui/uni-grid.html",
      "category": "布局/导航",
      "codeBlock": "uGrid",
      "related": [
        "uni-grid-item"
      ],
      "useWhen": "2-5 列功能入口、分类入口、九宫格菜单。",
      "figmaSignals": [
        "九宫格",
        "功能宫格",
        "分类图标网格",
        "四宫格",
        "grid menu",
        "app launcher"
      ],
      "props": [
        "column",
        "show-border",
        "square",
        "highlight"
      ],
      "events": [
        "@change"
      ],
      "skeleton": "<uni-grid :column=\"4\" :show-border=\"false\"><uni-grid-item v-for=\"item in menus\" :key=\"item.id\"><view class=\"grid-item\">...</view></uni-grid-item></uni-grid>",
      "avoid": "复杂响应式布局用 uni-row/uni-col；角标需自己或搭配 uni-badge；列数最好不超过 5。"
    },
    {
      "name": "uni-group",
      "cn": "分组",
      "doc": "https://uniapp.dcloud.net.cn/component/uniui/uni-group.html",
      "category": "内容容器",
      "codeBlock": "uGroup",
      "useWhen": "把表单项、列表区块、设置项分组并形成间隔。",
      "figmaSignals": [
        "分组标题",
        "区块间距",
        "设置分区",
        "表单分区",
        "group section"
      ],
      "props": [
        "title",
        "top",
        "mode"
      ],
