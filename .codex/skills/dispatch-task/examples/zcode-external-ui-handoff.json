{
  "dispatch_run_id": "example-zcode-ui-001",
  "implementation_mode": "external_implementer",
  "task": {
    "objective": "按目标 Figma 节点实现首页提醒卡片",
    "code_changes_required": true,
    "ui_task": true,
    "risk": "standard",
    "qa_required": true
  },
  "target_role": "external_implementer",
  "external_contract": {
    "provider": "zcode",
    "application": "ZCode",
    "target_session": "current_open_chat",
    "prompt_transport": "clipboard_paste",
    "prompt_sentinel_required": true,
    "prompt_integrity_check_required": true,
    "input_box_check_required": true,
    "send_receipt_required": true,
    "send_action_required": true,
    "allowed_send_actions": [
      "send_button",
      "blocked"
    ],
    "completion_claim_not_authoritative": true,
    "codex_self_implementation_forbidden": true,
    "generic_fallback_forbidden": true,
    "recovery_required": true,
    "handoff_manual_required": true,
    "handoff_completion_status_source": "handoff_manual",
    "prompt_max_chars": 30000,
    "required_prompt_sections": [
      "implementation_contract",
      "allowed_forbidden_paths",
      "project_constraints",
      "handoff_manual_contract",
      "validation_commands",
      "ui_scope_contract",
      "style_stack_contract",
      "figma_direct_fetch",
      "figma_blocker_policy",
      "uni_ui_mapping_contract",
      "result_json_contract"
    ],
    "computer_use_required": true,
    "actual_tool_invocation_required": true,
    "allowed_tool_targets": [
      "@ZCode",
      "@Computer"
    ],
    "minimum_tool_event_count": 5,
    "computer_use_tool_invocation_required": true,
    "computer_use_action_trace_required": true,
    "clipboard_bridge_required": true,
    "clipboard_bridge_evidence_required": true,
    "direct_input_injection_forbidden": true,
    "manual_typing_forbidden": true,
    "shell_only_ui_automation_forbidden": true,
    "required_computer_use_actions": [
      "verify_zcode_current_session",
      "locate_unique_entry_area",
      "focus_chat_input",
      "run_verified_clipboard_bridge",
      "paste_clipboard_via_cmd_v",
      "verify_paste_delivery",
      "open_edit_menu_if_needed",
      "paste_clipboard_via_edit_menu_if_needed",
      "send_prompt_after_integrity_check",
      "verify_post_send_delivery"
    ],
    "post_send_computer_use_policy": {
      "verify_current_chat_delivery": true,
      "disconnect_after_send_confirmed": true,
      "continuous_ui_monitoring_forbidden": true
    },
    "zcode_clipboard_bridge_authorization": {
      "mode": "current_turn_explicit",
      "enabled": true,
      "authorization_source": "user_explicit_for_dispatch"
    }
  },
  "handoff_manual": {
    "required": true,
    "path": ".tmp/dispatch-task/example-zcode-ui-001-handoff-manual.json",
    "status_field": "status",
    "working_status": "working",
    "terminal_statuses": [
      "completed",
      "blocked"
    ],
    "main_completion_probe": "read_json_before_ui"
  },
  "allowed_paths": [
    "src/pages/home/**",
    "src/components/home/**"
  ],
  "forbidden_paths": [
    "package.json",
    "package-lock.json",
    "src/api/**",
    "src/stores/**"
  ],
  "acceptance": [
    "视觉、文案与交互匹配目标 Figma 节点",
    "使用项目 TailwindCSS，不新增 SCSS",
    "优先复用现有组件与 uni-ui",
    "ZCode 只修改 allowed_paths 内文件",
    "完整 prompt 经本机剪贴板读回、可见输入交付与发送后会话交付三层验证"
  ],
  "project_constraints": {
    "rule_refs": [
      "AGENTS.md#UI-与样式"
    ],
    "framework": "uni-app + Vue",
    "styling_system": "tailwindcss",
    "new_scss_policy": "forbidden",
    "scss_exceptions": [],
    "component_library": "uni-ui",
    "dependency_policy": "no_new_dependencies",
    "test_commands": [
      "npm run typecheck",
      "npm run build:mp-weixin"
    ]
  },
  "decision_lock": {
    "level": "standard",
    "architecture_invariants": [
      "不得新增 store/API/schema",
      "不得修改提醒业务数据结构"
    ],
    "local_decisions_allowed": [
      "组件局部拆分",
      "Tailwind utility 组合",
      "现有组件或 uni-ui 复用落点"
    ]
  },
  "figma": {
    "required": true,
    "link": "https://figma.com/design/example/file?node-id=10-20",
    "node_id": "10:20",
    "mode": "external_prompt_recovery",
    "lite_status": "link_only",
    "main_access": "lite_only",
    "main_tools_used": [],
    "implementer_fetch_required": true,
    "qa_baseline_fetch_required": true
  },
  "brv_relevance": {
    "required": false,
    "reason": "UI example; no BRV content recall required"
  },
  "feature_test_plan": {
    "required": true,
    "targets": [
      "src/pages/home/**",
      "src/components/home/**"
    ],
    "commands": [
      "npm run typecheck",
      "npm run build:mp-weixin"
    ]
  },
  "e2e_plan": {
    "required": false,
    "automator_required": false,
    "catalog_required": false
  },
  "selection_to_consumer": {
    "required": false,
    "not_applicable_reason": "示例只演示外部实现者 UI handoff 合同，不新增用户可选值或业务提交分支。"
  },
  "required_skills": {
    "main": [
      "$qa-ui-visual-baseline-policy"
    ]
  },
  "validation": {
    "miniprogram_automator_required": false,
    "external": [
      "ZCode canonical prompt and verified visible clipboard receipt check",
      "git diff recovery",
      "unit/lint/typecheck/build/self-check"
    ],
    "worktree_baseline_path": ".tmp/dispatch-task/example-zcode-ui-001-worktree-baseline.json"
  },
  "output_evidence_required": [
    "zcode_send_receipt",
    "zcode_handoff_manual",
    "zcode_recovery_evidence",
    "validation_evidence",
    "figma_fetch_evidence",
    "style_stack_compliance",
    "component_reuse_evidence",
    "uni_ui_mapping_evidence"
  ],
  "dispatch_tier": "external_implementer"
}
