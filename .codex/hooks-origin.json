{
  "description": "Qinghuazhi TDD governance: Test First, exact human write authorization, shell anti-bypass, full UT stop gate.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/scripts/matrix-gate/codex-user-prompt-submit.mjs\"",
            "timeout": 30,
            "statusMessage": "Recording TDD turn policy"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/scripts/matrix-gate/codex-pre-tool-use.mjs\"",
            "timeout": 30,
            "statusMessage": "Checking Test First and write authorization"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/scripts/matrix-gate/codex-post-tool-use.mjs\"",
            "timeout": 30,
            "statusMessage": "Committing TDD evidence"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/scripts/ut-stop-gate.mjs\"",
            "timeout": 600,
            "statusMessage": "Running affected package unit tests"
          }
        ]
      }
    ]
  }
}
