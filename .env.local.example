# 本地 CloudBase HTTP 云函数调试示例
# 复制为 .env.local 后按需填写；.env.local 已被 .gitignore 忽略。

# 本地 gateway 默认端口；前端本地脚本会默认使用 http://127.0.0.1:3010
CLOUDBASE_LOCAL_FUNCTIONS_PORT=3010

# 小程序本地模式默认会自动启动完整本地函数 gateway。
# 如需手动管理 dev:functions，可关闭自动启动：
# CLOUDBASE_LOCAL_AUTO_START_FUNCTIONS=false

# 如只做单函数专项验证，可临时缩小检查范围，例如：
# CLOUDBASE_LOCAL_REQUIRED_FUNCTIONS=diagnose-http

# 微信开发者工具真机预览或网络隔离时，可手动指定本机局域网 IP
# CLOUDBASE_LOCAL_FUNCTIONS_HOST_IP=192.168.1.10

# 小程序本地调试使用的开发 openid。不要填真实用户敏感信息。
VITE_DEV_OPENID=dev_terminal_mp_local

# 默认 CloudBase 环境 ID，生产/测试云端路径仍由现有脚本控制。
VITE_CLOUDBASE_ENV_ID=cloud1-2grufevs395a9d5e
VITE_PLATFORM_PHONE_BOOTSTRAP_BASE_URL=https://cloud1-2grufevs395a9d5e-1403815561.ap-shanghai.app.tcloudbase.com
CLOUDBASE_ENV_ID=cloud1-2grufevs395a9d5e
TCB_ENV=cloud1-2grufevs395a9d5e

# 本地函数内部默认写读 development schema，不要在本地调试时指向 production。
APP_ENV=development
SCHEMA_ENV=development
SQL_DATABASE=cloud1_dev
SQL_DATABASE_DEV=cloud1_dev
CLOUDBASE_SQL_DATABASE=cloud1_dev
CLOUDBASE_SQL_DATABASE_DEV=cloud1_dev

# 完整删除使用原生 MySQL 事务。本地和线上 plant-user-http 必须配置同一组变量；
# 这里只保留变量名，禁止把真实 host、账号或密码提交到仓库。
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=cloud1_dev

# 微信支付月卡（仅在准备接入真实商户号时填写；不要提交真实密钥）
WECHAT_PAY_APPID=
WECHAT_PAY_MCHID=
WECHAT_PAY_MERCHANT_SERIAL_NO=
WECHAT_PAY_MERCHANT_PRIVATE_KEY_BASE64=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_PLATFORM_SERIAL_NO=
WECHAT_PAY_PLATFORM_PUBLIC_KEY_BASE64=
WECHAT_PAY_NOTIFY_URL=
# 留空使用服务端内置的免费方案 + 1 分/30 天开发测试方案
WECHAT_PAY_SUBSCRIPTION_PLANS_JSON=
DB_POOL_SIZE=3

# 可选：仅当 CloudBase 控制台里使用了非默认数据库连接名时填写。
# 不确定时保持为空；默认会使用内置 MySQL 连接。
CLOUDBASE_SQL_DBLINK_NAME=
SQL_DBLINK_NAME=

# 下面只列变量名，真实值只能放在未提交的 .env.local、shell 环境或 GitHub Secrets。
# 本地 HTTP 云函数如果访问 CloudBase SQL/Auth/Storage，需要填写任一组完整 SecretId/SecretKey。
# CLOUDBASE_*、TENCENT_*、TENCENTCLOUD_* 三套命名会在本地 gateway 中自动互相补齐。
CLOUDBASE_SECRET_ID=
CLOUDBASE_SECRET_KEY=
CLOUDBASE_TOKEN=
CLOUDBASE_APIKEY=
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_SESSION_TOKEN=
TENCENTCLOUD_SECRETID=
TENCENTCLOUD_SECRETKEY=
TENCENTCLOUD_SESSIONTOKEN=
TENCENTCLOUD_SESSION_TOKEN=
TCB_SESSIONTOKEN=
QWEATHER_API_KEY=

# 三端手机号会话（仅服务端/云函数环境变量；每项使用独立的随机高熵值）
PHONE_HASH_SECRET=
PHONE_ENCRYPTION_KEY=
PHONE_PROOF_SECRET=
SESSION_TOKEN_SECRET=
# 抖音手机号新方式需要平台开通资格及服务端 AppSecret；私钥必须与抖音后台当前应用公钥匹配。
# 生产默认使用官方接口；仅在沙盒/迁移期间覆盖 URL。所有值只放云函数环境变量。
DOUYIN_APP_SECRET=
DOUYIN_CODE2SESSION_URL=https://developer.toutiao.com/api/apps/v2/jscode2session
DOUYIN_CLIENT_TOKEN_URL=https://open.douyin.com/oauth/client_token/
DOUYIN_PHONE_NUMBER_URL=https://open.douyin.com/api/apps/v1/get_phonenumber_info/
# 二选一；本地/云函数推荐使用下一项，避免逐行解析截断 PEM。
DOUYIN_PHONE_PRIVATE_KEY=
# 把完整 PEM 文本（含 BEGIN/END 行）整体做标准 Base64 后填入，保持单行。
DOUYIN_PHONE_PRIVATE_KEY_BASE64=
# 小红书 code2Session 接口及 AppSecret，仅服务端保存。
XHS_APP_SECRET=
XHS_CODE2SESSION_URL=

# GitHub Actions 小程序发布变量。appid 可放 GitHub Variables，私钥必须放 GitHub Secrets。
WECHAT_MINIPROGRAM_APPID=
# 后端手机号证明校验使用的微信小程序 AppID（仅配置，不填写 AppSecret）
WECHAT_MINIPROGRAM_APP_ID=
# 微信手机号 code2Session 所需 AppSecret，仅放 wechat-phone 云函数环境变量
WECHAT_MINIPROGRAM_APP_SECRET=
WECHAT_MINIPROGRAM_PRIVATE_KEY=
MINIPROGRAM_CI_ACTION=preview
MINIPROGRAM_CI_ROBOT=1
