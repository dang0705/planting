{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:qinghuazhi:user-plant:profile-patch:v2",
  "title": "用户植物档案部分更新（含环境档案）",
  "description": "user-plant-environment-profile/v1：v1 的昵称与实测盆器语义不变；新增盆型材质、基质、位置、光照、通风五个分组，省略保留、null 清除。不接受任何派生值。",
  "type": "object",
  "additionalProperties": false,
  "required": ["version"],
  "minProperties": 2,
  "properties": {
    "version": { "type": "integer", "minimum": 1, "maximum": 4294967295, "description": "旧聚合版本，无符号SQL整数容量。" },
    "nickname": { "type": "string", "maxLength": 80, "description": "昵称原文，空字符串清除，不截断。" },
    "measuredPot": { "$ref": "urn:qinghuazhi:user-plant:measured-pot-profile:v1", "description": "完整实测子结构，未知成员显式null；省略保留；不接受null。" },
    "potShape": {
      "description": "盆型与盆壁材质；null 清除。",
      "oneOf": [
        { "type": "null" },
        { "type": "object", "additionalProperties": false, "required": ["shape", "wallMaterial"], "properties": {
          "shape": { "enum": ["round", "square", "hanging", "other", null] },
          "wallMaterial": { "enum": ["plastic", "glazed_ceramic", "terracotta", "cement", "fabric", "other", null] } } }
      ]
    },
    "substrate": {
      "description": "基质组分；primaryMaterial 必须属于 materials（由领域代码复核）；null 清除。",
      "oneOf": [
        { "type": "null" },
        { "type": "object", "additionalProperties": false, "required": ["materials", "primaryMaterial"], "properties": {
          "materials": { "type": "array", "minItems": 1, "maxItems": 9, "uniqueItems": true,
            "items": { "enum": ["general", "coco", "ceramsite", "peat", "perlite", "bark", "sphagnum", "gritty", "coarse_sand"] } },
          "primaryMaterial": { "enum": ["general", "coco", "ceramsite", "peat", "perlite", "bark", "sphagnum", "gritty", "coarse_sand", null] } } }
      ]
    },
    "location": {
      "description": "城市级位置与摆放类型，不含经纬度；cityRef 须存在于 weather 城市目录；null 清除。",
      "oneOf": [
        { "type": "null" },
        { "type": "object", "additionalProperties": false, "required": ["cityRef", "placement"], "properties": {
          "cityRef": { "type": "string", "pattern": "^[a-z0-9_-]{2,64}$" },
          "placement": { "enum": ["indoor", "balcony_enclosed", "balcony_open", "outdoor"] } } }
      ]
    },
    "lighting": {
      "description": "用户可理解的光照选项；null 清除。",
      "oneOf": [
        { "type": "null" },
        { "type": "object", "additionalProperties": false, "required": ["windowFacing", "glassLayers", "distanceBand", "obstruction"], "properties": {
          "windowFacing": { "enum": ["N", "NE", "E", "SE", "S", "SW", "W", "NW", "none"] },
          "glassLayers": { "enum": [0, 1, 2, 3] },
          "distanceBand": { "enum": ["on_sill", "within_1m", "one_to_three_m", "beyond_3m"] },
          "obstruction": { "enum": ["none", "partial", "heavy"] } } }
      ]
    },
    "ventilation": {
      "description": "通风与空气环境；不等同室外风速；null 清除。",
      "oneOf": [
        { "type": "null" },
        { "type": "object", "additionalProperties": false, "required": ["airExchange", "localAirflow", "directBlowing"], "properties": {
          "airExchange": { "enum": ["closed", "occasional", "frequent"] },
          "localAirflow": { "enum": ["none", "fan", "ac", "heater", "natural_draft"] },
          "directBlowing": { "type": ["boolean", "null"] } } }
      ]
    }
  }
}
