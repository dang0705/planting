    <informationRequirement id="mvp_decision_watering_action_req_2">
      <requiredDecision href="#mvp_decision_soil_gate" />
    </informationRequirement>
    <informationRequirement id="mvp_decision_watering_action_req_3">
      <requiredDecision href="#mvp_decision_drying_window_state" />
    </informationRequirement>
    <informationRequirement id="mvp_decision_watering_action_req_4">
      <requiredDecision href="#mvp_decision_pot_safety" />
    </informationRequirement>
    <decisionTable id="mvp_decision_watering_action_table" hitPolicy="FIRST">
      <input id="mvp_decision_watering_action_in_0" label="有活动策略">
