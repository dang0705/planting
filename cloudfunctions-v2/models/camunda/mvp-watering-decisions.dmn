        <inputEntry id="mvp_decision_plant_light_anchor_rule_6_in_3">
          <text>-</text>
        </inputEntry>
        <inputEntry id="mvp_decision_plant_light_anchor_rule_6_in_4">
          <text>-</text>
        </inputEntry>
        <outputEntry id="mvp_decision_plant_light_anchor_rule_6_out_0">
          <text>&quot;available&quot;</text>
        </outputEntry>
        <outputEntry id="mvp_decision_plant_light_anchor_rule_6_out_1">
          <text>null</text>
        </outputEntry>
      </rule>
    </decisionTable>
  </decision>
  <decision id="mvp_decision_watering_action" name="浇水行动（是否可浇水门）">
    <description>assessMvpWatering 前置出口＋evaluateWateringDecision 最终行动（按顺序命中）。允许浇水不等于已发生浇水；不写计划、事实或提醒。</description>
    <informationRequirement id="mvp_decision_watering_action_req_0">
      <requiredInput href="#mvp_input_policy_snapshot" />
    </informationRequirement>
    <informationRequirement id="mvp_decision_watering_action_req_1">
      <requiredDecision href="#mvp_decision_moisture_group" />
