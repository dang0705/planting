  <decision id="mvp_decision_water_amount" name="水量估算">
    <description>estimateMvpWaterAmount（合同 §4），仅在行动为 water_allowed 时调用。V=截锥在“盆高−留空”处装土体积；净补水 N=[Vmin×dmin×AWmin, Vmax×dmax×AWmax]；建议浇入=[Nmin/(1−LFmin), Nmax/(1−LFmax)]，四舍五入到 10mL，且不超过 Vmax×CCmax/(1−LFmax)。AW 与 CCmax 按“基质可用水（主要材料规则）”同一混合规则（v3 才使用主要材料）。几何/排水分支在 MVP 路径中已被盆器安全门前置覆盖，代码保留为防御分支。</description>
    <informationRequirement id="mvp_decision_water_amount_req_0">
      <requiredDecision href="#mvp_decision_watering_action" />
    </informationRequirement>
    <informationRequirement id="mvp_decision_water_amount_req_1">
      <requiredDecision href="#mvp_decision_moisture_group" />
    </informationRequirement>
    <informationRequirement id="mvp_decision_water_amount_req_2">
      <requiredDecision href="#mvp_decision_substrate_available_water" />
    </informationRequirement>
    <informationRequirement id="mvp_decision_water_amount_req_3">
      <requiredInput href="#mvp_input_measured_pot" />
    </informationRequirement>
    <authorityRequirement id="mvp_decision_water_amount_req_4">
      <requiredAuthority href="#mvp_knowledge_amount" />
    </authorityRequirement>
    <decisionTable id="mvp_decision_water_amount_table" hitPolicy="FIRST">
      <input id="mvp_decision_water_amount_in_0" label="浇水行动">
        <inputExpression id="mvp_decision_water_amount_in_0_expr" typeRef="string">
          <text>watering_action</text>
        </inputExpression>
      </input>
      <input id="mvp_decision_water_amount_in_1" label="内盆几何可用">
        <inputExpression id="mvp_decision_water_amount_in_1_expr" typeRef="boolean">
          <text>measured_pot.geometry != null</text>
        </inputExpression>
      </input>
      <input id="mvp_decision_water_amount_in_2" label="有排水">
        <inputExpression id="mvp_decision_water_amount_in_2_expr" typeRef="boolean">
          <text>measured_pot.drainageAvailable</text>
        </inputExpression>
      </input>
      <input id="mvp_decision_water_amount_in_3" label="已选材料">
        <inputExpression id="mvp_decision_water_amount_in_3_expr" typeRef="boolean">
          <text>mix_rule != &quot;none&quot;</text>
        </inputExpression>
      </input>
      <input id="mvp_decision_water_amount_in_4" label="湿度分组">
        <inputExpression id="mvp_decision_water_amount_in_4_expr" typeRef="string">
          <text>moisture_group</text>
        </inputExpression>
      </input>
      <output id="mvp_decision_water_amount_out_0" name="amount_status" label="水量结论" typeRef="string" />
      <output id="mvp_decision_water_amount_out_1" name="amount_missing" label="缺失证据" typeRef="string" />
      <output id="mvp_decision_water_amount_out_2" name="depletion_min" label="消耗比例下界" typeRef="number" />
      <output id="mvp_decision_water_amount_out_3" name="depletion_max" label="消耗比例上界" typeRef="number" />
      <rule id="mvp_decision_water_amount_rule_0">
        <description>不调用估算</description>
        <inputEntry id="mvp_decision_water_amount_rule_0_in_0">
          <text>not(&quot;water_allowed&quot;)</text>
        </inputEntry>
        <inputEntry id="mvp_decision_water_amount_rule_0_in_1">
