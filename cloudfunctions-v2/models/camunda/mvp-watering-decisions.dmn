          <text>material</text>
        </inputExpression>
      </input>
      <output id="mvp_decision_substrate_properties_out_0" name="cc_min" label="持水量下界" typeRef="number" />
      <output id="mvp_decision_substrate_properties_out_1" name="cc_max" label="持水量上界" typeRef="number" />
      <output id="mvp_decision_substrate_properties_out_2" name="aw_min" label="可用水（AW）下界" typeRef="number" />
      <output id="mvp_decision_substrate_properties_out_3" name="aw_max" label="可用水（AW）上界" typeRef="number" />
