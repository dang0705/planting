  <decision id="mvp_decision_substrate_properties" name="基质物性">
    <description>按单一材料查已发布物性（v2、v3 同值）；多材料的混合由“基质可用水（主要材料规则）”处理。策略须满足可用水上界 ≤ 持水量下界，否则拒绝。</description>
    <informationRequirement id="mvp_decision_substrate_properties_req_0">
      <requiredInput href="#mvp_input_substrate_materials" />
    </informationRequirement>
    <authorityRequirement id="mvp_decision_substrate_properties_req_1">
      <requiredAuthority href="#mvp_knowledge_substrates" />
    </authorityRequirement>
    <decisionTable id="mvp_decision_substrate_properties_table" hitPolicy="UNIQUE">
      <input id="mvp_decision_substrate_properties_in_0" label="材料代码">
