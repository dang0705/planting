        </inputExpression>
      </input>
      <output id="mvp_decision_watering_action_out_0" name="watering_action" label="浇水行动" typeRef="string" />
      <output id="mvp_decision_watering_action_out_1" name="direct_missing_evidence" label="前置缺失证据" typeRef="string" />
      <rule id="mvp_decision_watering_action_rule_0">
        <description>无发布：不启用旧算法</description>
        <inputEntry id="mvp_decision_watering_action_rule_0_in_0">
          <text>false</text>
        </inputEntry>
        <inputEntry id="mvp_decision_watering_action_rule_0_in_1">
          <text>-</text>
        </inputEntry>
        <inputEntry id="mvp_decision_watering_action_rule_0_in_2">
          <text>-</text>
        </inputEntry>
        <inputEntry id="mvp_decision_watering_action_rule_0_in_3">
          <text>-</text>
        </inputEntry>
        <inputEntry id="mvp_decision_watering_action_rule_0_in_4">
          <text>-</text>
