        </outputEntry>
        <outputEntry id="mvp_decision_public_result_rule_1_out_3">
          <text>&quot;low&quot;</text>
        </outputEntry>
      </rule>
      <rule id="mvp_decision_public_result_rule_2">
        <inputEntry id="mvp_decision_public_result_rule_2_in_0">
