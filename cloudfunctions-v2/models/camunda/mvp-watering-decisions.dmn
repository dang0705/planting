      <output id="mvp_decision_public_result_out_1" name="public_action" label="公开行动" typeRef="string" />
      <output id="mvp_decision_public_result_out_2" name="missing_evidence" label="缺失证据" typeRef="string" />
      <output id="mvp_decision_public_result_out_3" name="confidence" label="置信度" typeRef="string" />
      <rule id="mvp_decision_public_result_rule_0">
        <inputEntry id="mvp_decision_public_result_rule_0_in_0">
