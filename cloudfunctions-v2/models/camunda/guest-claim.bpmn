<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="guest_claim_definitions" targetNamespace="http://bpmn.io/schema/bpmn" exporter="qinghuazhi-model-layout" exporterVersion="1.0.0">
  <bpmn:error id="gc_error_503_guest_issue_unavailable" name="GUEST_ISSUE_UNAVAILABLE" errorCode="503" />
  <bpmn:error id="gc_error_429_rate_limited" name="RATE_LIMITED" errorCode="429" />
  <bpmn:error id="gc_error_503_service_unavailable" name="SERVICE_UNAVAILABLE" errorCode="503" />
  <bpmn:error id="gc_error_401_principal_invalid" name="PRINCIPAL_INVALID" errorCode="401" />
  <bpmn:error id="gc_error_409_temporary_case_limit_reached" name="TEMPORARY_CASE_LIMIT_REACHED" errorCode="409" />
  <bpmn:error id="gc_error_401_login_principal_invalid" name="LOGIN_PRINCIPAL_INVALID" errorCode="401" />
  <bpmn:error id="gc_error_503_login_service_unavailable" name="LOGIN_SERVICE_UNAVAILABLE" errorCode="503" />
  <bpmn:error id="gc_error_401_claim_request_rejected" name="CLAIM_REQUEST_REJECTED" errorCode="401" />
  <bpmn:error id="gc_error_409_idempotency_conflict" name="IDEMPOTENCY_CONFLICT" errorCode="409" />
  <bpmn:error id="gc_error_409_guest_session_not_claimable" name="GUEST_SESSION_NOT_CLAIMABLE" errorCode="409" />
  <bpmn:error id="gc_error_410_guest_session_expired" name="GUEST_SESSION_EXPIRED" errorCode="410" />
  <bpmn:error id="gc_error_503_claim_processing" name="CLAIM_PROCESSING" errorCode="503" />
  <bpmn:error id="gc_error_409_guest_session_not_claimable_failed" name="GUEST_SESSION_NOT_CLAIMABLE_FAILED" errorCode="409" />
  <bpmn:error id="gc_error_409_claim_completion_rejected" name="CLAIM_COMPLETION_REJECTED" errorCode="409" />
  <bpmn:error id="gc_error_410_guest_session_expired_completion" name="GUEST_SESSION_EXPIRED_COMPLETION" errorCode="410" />
  <bpmn:collaboration id="guest_claim_collaboration">
    <bpmn:participant id="guest_claim_participant" name="游客 → 临时案例 → 登录 → 认领" processRef="guest_claim_process" />
  </bpmn:collaboration>
  <bpmn:process id="guest_claim_process" name="游客临时案例与登录认领（guest-session-claim/v1）" isExecutable="false">
    <bpmn:documentation>反映 createGuestSessionRouteHandler、createTemporaryCaseApplicationService、登录会话签发、createClaimGuestPlantCaseApplicationService 与 decideGuestClaimLease。认领状态机 requested → processing → completed；处理租约 30 秒（硬规则 user-plant.guest_claim.processing_lease_seconds）。</bpmn:documentation>
    <bpmn:laneSet id="guest_claim_lanes">
      <bpmn:lane id="gc_lane_user" name="用户 / 小程序">
        <bpmn:flowNodeRef>gc_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gc_create_case_req</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gc_login_req</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gc_claim_req</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gc_end_ok</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="gc_lane_identity" name="identity 域">
        <bpmn:flowNodeRef>gc_guest_policy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gc_gw_guest_policy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gc_end_guest_policy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gc_gw_douyin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gc_gw_douyin_merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gc_issue_guest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gc_gw_issue</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gc_end_issue_429</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gc_end_issue_503</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gc_login_input</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gc_issue_session</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gc_gw_login</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gc_end_login_401</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gc_end_login_503</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="gc_lane_user_plant" name="user-plant 域">
        <bpmn:flowNodeRef>gc_lock_session</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gc_gw_case</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gc_end_case_401</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gc_end_case_409</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gc_insert_case</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gc_claim_input</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gc_gw_claim_input</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gc_end_claim_input</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gc_gw_target</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gc_gw_target_merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gc_receipt</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gc_gw_receipt</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gc_end_receipt_409</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gc_register</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gc_gw_register</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gc_end_register_409</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gc_end_register_410</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gc_gw_lease</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gc_end_lease_503</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gc_gw_terminal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gc_end_failed_409</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gc_recheck_receipt</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gc_complete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gc_gw_complete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gc_end_complete_reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gc_end_complete_410</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gc_gw_success_merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gc_object_kinds</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="gc_lane_subscription" name="subscription 域">
        <bpmn:flowNodeRef>gc_capability</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="gc_lane_provider" name="外部 Provider">
        <bpmn:flowNodeRef>gc_douyin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gc_verify_code</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="gc_start" name="未登录进入小程序">
      <bpmn:outgoing>gc_f01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="gc_guest_policy" name="游客签发：DTO、锁定游客策略与摘要子密钥">
      <bpmn:documentation>POST /api/v2/identity/guest-sessions；不读取任何 IP 请求头。DTO 不合法 400。</bpmn:documentation>
      <bpmn:incoming>gc_f01</bpmn:incoming>
      <bpmn:outgoing>gc_f02</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="gc_gw_guest_policy" name="可签发？">
      <bpmn:incoming>gc_f02</bpmn:incoming>
      <bpmn:outgoing>gc_f03</bpmn:outgoing>
      <bpmn:outgoing>gc_f04</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="gc_end_guest_policy" name="400 / 503">
      <bpmn:documentation>DTO 不合法 400；无可信策略或子密钥 503（失败关闭）。</bpmn:documentation>
      <bpmn:incoming>gc_f03</bpmn:incoming>
      <bpmn:errorEventDefinition id="gc_end_guest_policy_error_def" errorRef="gc_error_503_guest_issue_unavailable" />
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="gc_gw_douyin" name="抖音且带 anonymousCode 且开关开启？">
      <bpmn:incoming>gc_f04</bpmn:incoming>
      <bpmn:outgoing>gc_f05</bpmn:outgoing>
      <bpmn:outgoing>gc_f07</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="gc_douyin" name="换取 anonymous_openid（失败按无信号）">
      <bpmn:documentation>只取 HMAC 摘要；anonymousCode 与匿名 openid 不进入日志、审计或响应。</bpmn:documentation>
      <bpmn:incoming>gc_f05</bpmn:incoming>
      <bpmn:outgoing>gc_f06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="gc_gw_douyin_merge" name="">
      <bpmn:incoming>gc_f06</bpmn:incoming>
      <bpmn:incoming>gc_f07</bpmn:incoming>
      <bpmn:outgoing>gc_f08</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="gc_issue_guest" name="按匿名信号限流并签发游客会话">
      <bpmn:documentation>issueGuestSession；令牌只在成功响应出现一次。</bpmn:documentation>
      <bpmn:incoming>gc_f08</bpmn:incoming>
      <bpmn:outgoing>gc_f09</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="gc_gw_issue" name="签发结果？">
      <bpmn:incoming>gc_f09</bpmn:incoming>
      <bpmn:outgoing>gc_f10</bpmn:outgoing>
      <bpmn:outgoing>gc_f11</bpmn:outgoing>
      <bpmn:outgoing>gc_f12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="gc_end_issue_429" name="429 RATE_LIMITED">
      <bpmn:incoming>gc_f10</bpmn:incoming>
      <bpmn:errorEventDefinition id="gc_end_issue_429_error_def" errorRef="gc_error_429_rate_limited" />
    </bpmn:endEvent>
    <bpmn:endEvent id="gc_end_issue_503" name="503 SERVICE_UNAVAILABLE">
      <bpmn:incoming>gc_f11</bpmn:incoming>
      <bpmn:errorEventDefinition id="gc_end_issue_503_error_def" errorRef="gc_error_503_service_unavailable" />
    </bpmn:endEvent>
    <bpmn:userTask id="gc_create_case_req" name="保存 guestToken，提交创建临时案例">
      <bpmn:documentation>POST /api/v2/user-plants/temporary-cases（游客 Bearer + Idempotency-Key）。</bpmn:documentation>
      <bpmn:incoming>gc_f12</bpmn:incoming>
      <bpmn:outgoing>gc_f13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:task id="gc_lock_session" name="事务：幂等占位 → 锁游客会话并计数有效案例">
      <bpmn:incoming>gc_f13</bpmn:incoming>
      <bpmn:outgoing>gc_f14</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="gc_gw_case" name="可创建？">
      <bpmn:incoming>gc_f14</bpmn:incoming>
      <bpmn:outgoing>gc_f15</bpmn:outgoing>
      <bpmn:outgoing>gc_f16</bpmn:outgoing>
      <bpmn:outgoing>gc_f17</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="gc_end_case_401" name="401 PRINCIPAL_INVALID">
      <bpmn:incoming>gc_f15</bpmn:incoming>
      <bpmn:errorEventDefinition id="gc_end_case_401_error_def" errorRef="gc_error_401_principal_invalid" />
    </bpmn:endEvent>
    <bpmn:endEvent id="gc_end_case_409" name="409 TEMPORARY_CASE_LIMIT_REACHED">
      <bpmn:incoming>gc_f16</bpmn:incoming>
      <bpmn:errorEventDefinition id="gc_end_case_409_error_def" errorRef="gc_error_409_temporary_case_limit_reached" />
    </bpmn:endEvent>
    <bpmn:task id="gc_insert_case" name="写入案例 gpc_（失效＝游客会话失效）并读回">
      <bpmn:documentation>decideGuestTemporaryCase；游客没有独立案例有效期配置。确定拒绝也记为幂等首次结果。</bpmn:documentation>
      <bpmn:incoming>gc_f17</bpmn:incoming>
      <bpmn:outgoing>gc_f18</bpmn:outgoing>
    </bpmn:task>
    <bpmn:userTask id="gc_login_req" name="使用临时案例后选择登录">
      <bpmn:documentation>临时案例可用于浇水建议（流程①临时案例分支）。登录：POST /api/v2/identity/sessions（一次性平台 code，不要求 Idempotency-Key）。</bpmn:documentation>
      <bpmn:incoming>gc_f18</bpmn:incoming>
      <bpmn:outgoing>gc_f19</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:task id="gc_login_input" name="登录请求校验">
      <bpmn:incoming>gc_f19</bpmn:incoming>
      <bpmn:outgoing>gc_f20</bpmn:outgoing>
    </bpmn:task>
    <bpmn:serviceTask id="gc_verify_code" name="验真一次性平台 code">
      <bpmn:documentation>微信/抖音/小红书受控 Provider；未配置平台失败关闭。同一 code 重试拒绝。</bpmn:documentation>
      <bpmn:incoming>gc_f20</bpmn:incoming>
      <bpmn:outgoing>gc_f21</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:task id="gc_issue_session" name="解析或创建统一 user_id，签发 Bearer 会话">
      <bpmn:documentation>(platform, platform_subject_id) 唯一约束保证不重复创建用户或绑定。</bpmn:documentation>
      <bpmn:incoming>gc_f21</bpmn:incoming>
      <bpmn:outgoing>gc_f22</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="gc_gw_login" name="登录成功？">
      <bpmn:incoming>gc_f22</bpmn:incoming>
      <bpmn:outgoing>gc_f23</bpmn:outgoing>
      <bpmn:outgoing>gc_f24</bpmn:outgoing>
      <bpmn:outgoing>gc_f25</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="gc_end_login_401" name="400 / 401 凭证无效">
      <bpmn:documentation>输入不合法 400；平台凭证无效或已消费 401。</bpmn:documentation>
      <bpmn:incoming>gc_f23</bpmn:incoming>
      <bpmn:errorEventDefinition id="gc_end_login_401_error_def" errorRef="gc_error_401_login_principal_invalid" />
    </bpmn:endEvent>
    <bpmn:endEvent id="gc_end_login_503" name="503 SERVICE_UNAVAILABLE">
      <bpmn:incoming>gc_f24</bpmn:incoming>
      <bpmn:errorEventDefinition id="gc_end_login_503_error_def" errorRef="gc_error_503_login_service_unavailable" />
    </bpmn:endEvent>
    <bpmn:userTask id="gc_claim_req" name="提交认领（登录 Bearer＋guestToken＋案例＋目标）">
      <bpmn:documentation>POST /api/v2/user-plants/claims；目标为 existing_user_plant 或 new_user_plant。</bpmn:documentation>
      <bpmn:incoming>gc_f25</bpmn:incoming>
      <bpmn:outgoing>gc_f26</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:task id="gc_claim_input" name="请求限制、登录主体、DTO 与幂等键">
      <bpmn:incoming>gc_f26</bpmn:incoming>
      <bpmn:outgoing>gc_f27</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="gc_gw_claim_input" name="请求合法？">
      <bpmn:incoming>gc_f27</bpmn:incoming>
      <bpmn:outgoing>gc_f28</bpmn:outgoing>
      <bpmn:outgoing>gc_f29</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="gc_end_claim_input" name="401 / 400 / 413 / 415">
      <bpmn:incoming>gc_f28</bpmn:incoming>
      <bpmn:errorEventDefinition id="gc_end_claim_input_error_def" errorRef="gc_error_401_claim_request_rejected" />
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="gc_gw_target" name="新建植物？">
      <bpmn:incoming>gc_f29</bpmn:incoming>
      <bpmn:outgoing>gc_f30</bpmn:outgoing>
      <bpmn:outgoing>gc_f32</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="gc_capability" name="读取能力快照（失败为 null）">
      <bpmn:documentation>缺能力不猜测授权，由完成事务判定。</bpmn:documentation>
      <bpmn:incoming>gc_f30</bpmn:incoming>
      <bpmn:outgoing>gc_f31</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="gc_gw_target_merge" name="">
      <bpmn:incoming>gc_f31</bpmn:incoming>
      <bpmn:incoming>gc_f32</bpmn:incoming>
      <bpmn:outgoing>gc_f33</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="gc_receipt" name="读取原成功收据（新连接只读）">
      <bpmn:incoming>gc_f33</bpmn:incoming>
      <bpmn:outgoing>gc_f34</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="gc_gw_receipt" name="已有收据？">
      <bpmn:incoming>gc_f34</bpmn:incoming>
      <bpmn:outgoing>gc_f35</bpmn:outgoing>
      <bpmn:outgoing>gc_f36</bpmn:outgoing>
      <bpmn:outgoing>gc_f37</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="gc_end_receipt_409" name="409 IDEMPOTENCY_CONFLICT">
      <bpmn:incoming>gc_f35</bpmn:incoming>
      <bpmn:errorEventDefinition id="gc_end_receipt_409_error_def" errorRef="gc_error_409_idempotency_conflict" />
    </bpmn:endEvent>
    <bpmn:task id="gc_register" name="事务一：登记命令 requested → 取得处理租约">
      <bpmn:documentation>register + leaseRepository.acquire 同一事务；登记或租约阶段异常回滚并返回 503。</bpmn:documentation>
      <bpmn:incoming>gc_f36</bpmn:incoming>
      <bpmn:outgoing>gc_f38</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="gc_gw_register" name="登记结果？">
      <bpmn:incoming>gc_f38</bpmn:incoming>
      <bpmn:outgoing>gc_f39</bpmn:outgoing>
      <bpmn:outgoing>gc_f40</bpmn:outgoing>
      <bpmn:outgoing>gc_f41</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="gc_end_register_409" name="409 / 401 / 503">
      <bpmn:documentation>不可认领或幂等冲突 409；主体无效 401；存储不可用 503。</bpmn:documentation>
      <bpmn:incoming>gc_f39</bpmn:incoming>
      <bpmn:errorEventDefinition id="gc_end_register_409_error_def" errorRef="gc_error_409_guest_session_not_claimable" />
    </bpmn:endEvent>
    <bpmn:endEvent id="gc_end_register_410" name="410 GUEST_SESSION_EXPIRED">
      <bpmn:incoming>gc_f40</bpmn:incoming>
      <bpmn:errorEventDefinition id="gc_end_register_410_error_def" errorRef="gc_error_410_guest_session_expired" />
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="gc_gw_lease" name="租约裁决？">
      <bpmn:incoming>gc_f41</bpmn:incoming>
      <bpmn:outgoing>gc_f42</bpmn:outgoing>
      <bpmn:outgoing>gc_f43</bpmn:outgoing>
      <bpmn:outgoing>gc_f44</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="gc_end_lease_503" name="503 处理中（同键重试）">
      <bpmn:documentation>他人持有未过期租约（now &lt; leaseExpiresAt），不接管。</bpmn:documentation>
      <bpmn:incoming>gc_f42</bpmn:incoming>
      <bpmn:errorEventDefinition id="gc_end_lease_503_error_def" errorRef="gc_error_503_claim_processing" />
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="gc_gw_terminal" name="命令终态？">
      <bpmn:incoming>gc_f43</bpmn:incoming>
      <bpmn:outgoing>gc_f45</bpmn:outgoing>
      <bpmn:outgoing>gc_f46</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="gc_end_failed_409" name="409 GUEST_SESSION_NOT_CLAIMABLE">
      <bpmn:incoming>gc_f45</bpmn:incoming>
      <bpmn:errorEventDefinition id="gc_end_failed_409_error_def" errorRef="gc_error_409_guest_session_not_claimable_failed" />
    </bpmn:endEvent>
    <bpmn:task id="gc_recheck_receipt" name="只读核对原收据">
      <bpmn:documentation>核对不到为 503。</bpmn:documentation>
      <bpmn:incoming>gc_f46</bpmn:incoming>
      <bpmn:outgoing>gc_f47</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="gc_complete" name="事务二：完成认领（持有者匹配且租约未过期才写）">
      <bpmn:documentation>取得 = 首次（attempt=1）、过期接管（attempt+1，换持有者）或本人已持有；新建植物校验能力快照；提交未知时只读核对。</bpmn:documentation>
      <bpmn:incoming>gc_f44</bpmn:incoming>
      <bpmn:outgoing>gc_f48</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="gc_gw_complete" name="完成结果？">
      <bpmn:incoming>gc_f48</bpmn:incoming>
      <bpmn:outgoing>gc_f49</bpmn:outgoing>
      <bpmn:outgoing>gc_f50</bpmn:outgoing>
      <bpmn:outgoing>gc_f51</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="gc_end_complete_reject" name="409 / 401 / 403 / 503">
      <bpmn:documentation>not_claimable 409、capability_snapshot_expired 409、principal_invalid 401、capability_denied 403、unavailable 503。</bpmn:documentation>
      <bpmn:incoming>gc_f49</bpmn:incoming>
      <bpmn:errorEventDefinition id="gc_end_complete_reject_error_def" errorRef="gc_error_409_claim_completion_rejected" />
    </bpmn:endEvent>
    <bpmn:endEvent id="gc_end_complete_410" name="410 GUEST_SESSION_EXPIRED">
      <bpmn:incoming>gc_f50</bpmn:incoming>
      <bpmn:errorEventDefinition id="gc_end_complete_410_error_def" errorRef="gc_error_410_guest_session_expired_completion" />
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="gc_gw_success_merge" name="">
      <bpmn:incoming>gc_f37</bpmn:incoming>
      <bpmn:incoming>gc_f47</bpmn:incoming>
      <bpmn:incoming>gc_f51</bpmn:incoming>
      <bpmn:outgoing>gc_f52</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="gc_object_kinds" name="读取已认领对象类别">
      <bpmn:documentation>读取失败 503；replayed = 结果 claimRef ≠ 本次候选。</bpmn:documentation>
      <bpmn:incoming>gc_f52</bpmn:incoming>
      <bpmn:outgoing>gc_f53</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="gc_end_ok" name="200 认领成功（userPlantId）">
      <bpmn:incoming>gc_f53</bpmn:incoming>
    </bpmn:endEvent>
