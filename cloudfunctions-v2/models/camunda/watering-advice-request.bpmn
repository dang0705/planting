<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="watering_advice_request_definitions" targetNamespace="http://bpmn.io/schema/bpmn" exporter="qinghuazhi-model-layout" exporterVersion="1.0.0">
  <bpmn:error id="wa_error_415_unsupported_media_type_or_payload_too_large" name="UNSUPPORTED_MEDIA_TYPE_OR_PAYLOAD_TOO_LARGE" errorCode="415" />
  <bpmn:error id="wa_error_401_principal_invalid" name="PRINCIPAL_INVALID" errorCode="401" />
  <bpmn:error id="wa_error_400_validation_failed" name="VALIDATION_FAILED" errorCode="400" />
  <bpmn:error id="wa_error_404_not_found" name="NOT_FOUND" errorCode="404" />
  <bpmn:error id="wa_error_404_user_plant_not_found_or_archived" name="USER_PLANT_NOT_FOUND_OR_ARCHIVED" errorCode="404" />
  <bpmn:error id="wa_error_503_service_unavailable" name="SERVICE_UNAVAILABLE" errorCode="503" />
  <bpmn:error id="wa_error_409_idempotency_conflict_or_not_found" name="IDEMPOTENCY_CONFLICT_OR_NOT_FOUND" errorCode="409" />
  <bpmn:error id="wa_error_503_service_unavailable_retry" name="SERVICE_UNAVAILABLE_RETRY" errorCode="503" />
  <bpmn:collaboration id="watering_advice_request_collaboration">
    <bpmn:participant id="watering_advice_request_participant" name="POST /api/v2/care/watering-advice" processRef="watering_advice_request_process" />
  </bpmn:collaboration>
  <bpmn:process id="watering_advice_request_process" name="浇水建议请求（watering-advice/v1）" isExecutable="false">
    <bpmn:documentation>反映 createWateringAdviceRouteHandler 固定请求链：限制 → 认证 → 主体 → DTO → 归属前置 → 策略/基线/辐射 → 组装（纯计算）→ 幂等事务 → 白名单响应。外部读取全部在事务前完成。</bpmn:documentation>
    <bpmn:laneSet id="watering_advice_request_lanes">
      <bpmn:lane id="wa_lane_user" name="用户 / 小程序">
        <bpmn:flowNodeRef>wa_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wa_end_ok</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="wa_lane_identity" name="identity 域">
        <bpmn:flowNodeRef>wa_principal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wa_gw_principal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wa_end_401</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="wa_lane_care" name="care 云函数">
        <bpmn:flowNodeRef>wa_limits</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wa_gw_limits</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wa_end_413_415</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wa_dto</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wa_gw_dto</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wa_end_400</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wa_read_policy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wa_gw_reads</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wa_end_reads_503</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wa_window</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wa_light</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wa_light_response</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wa_vpd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wa_retention</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wa_demand</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wa_progress</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wa_build</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wa_gw_persist</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wa_txn_case</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wa_txn_plant</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wa_gw_persist_merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wa_gw_txn</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wa_end_txn_409</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wa_end_txn_503</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="wa_lane_user_plant" name="user-plant 域">
        <bpmn:flowNodeRef>wa_gw_target</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wa_read_case</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wa_gw_case</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wa_end_case_404</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wa_read_plant</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wa_gw_plant</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wa_end_plant_reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wa_gw_target_merge</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="wa_lane_knowledge" name="plant-knowledge 域">
        <bpmn:flowNodeRef>wa_read_baseline</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="wa_lane_provider" name="外部 Provider">
        <bpmn:flowNodeRef>wa_fetch</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="wa_start" name="发起浇水建议">
      <bpmn:outgoing>wa_f01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="wa_limits" name="请求限制：JSON 媒体类型与 1MB 上限">
      <bpmn:documentation>readRestrictedRequest：媒体类型 → 415，超过 1,048,576 字节 → 413；先于认证。</bpmn:documentation>
      <bpmn:incoming>wa_f01</bpmn:incoming>
      <bpmn:outgoing>wa_f02</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="wa_gw_limits" name="请求可接收？">
      <bpmn:incoming>wa_f02</bpmn:incoming>
      <bpmn:outgoing>wa_f03</bpmn:outgoing>
      <bpmn:outgoing>wa_f04</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="wa_end_413_415" name="415 / 413 拒绝">
      <bpmn:incoming>wa_f03</bpmn:incoming>
      <bpmn:errorEventDefinition id="wa_end_413_415_error_def" errorRef="wa_error_415_unsupported_media_type_or_payload_too_large" />
    </bpmn:endEvent>
    <bpmn:task id="wa_principal" name="解析 Bearer 主体（游客或登录用户）">
      <bpmn:documentation>guest_or_authenticated：resolvePrincipal + 合同校验 + issuedAt ≤ now &lt; expiresAt。</bpmn:documentation>
      <bpmn:incoming>wa_f04</bpmn:incoming>
      <bpmn:outgoing>wa_f05</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="wa_gw_principal" name="主体有效？">
      <bpmn:incoming>wa_f05</bpmn:incoming>
      <bpmn:outgoing>wa_f06</bpmn:outgoing>
      <bpmn:outgoing>wa_f07</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="wa_end_401" name="401 PRINCIPAL_INVALID">
      <bpmn:incoming>wa_f06</bpmn:incoming>
      <bpmn:errorEventDefinition id="wa_end_401_error_def" errorRef="wa_error_401_principal_invalid" />
    </bpmn:endEvent>
    <bpmn:task id="wa_dto" name="DTO 校验与唯一 Idempotency-Key">
      <bpmn:documentation>parseWateringAdviceRequest；坐标降到 0.01°；长期植物目标不得提交 catalogTaxonRef/pot/lastWatering；请求摘要为规范 JSON SHA-256。</bpmn:documentation>
      <bpmn:incoming>wa_f07</bpmn:incoming>
      <bpmn:outgoing>wa_f08</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="wa_gw_dto" name="DTO 合法？">
      <bpmn:incoming>wa_f08</bpmn:incoming>
      <bpmn:outgoing>wa_f09</bpmn:outgoing>
      <bpmn:outgoing>wa_f10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="wa_end_400" name="400 VALIDATION_FAILED">
      <bpmn:incoming>wa_f09</bpmn:incoming>
      <bpmn:errorEventDefinition id="wa_end_400_error_def" errorRef="wa_error_400_validation_failed" />
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="wa_gw_target" name="目标类型？">
      <bpmn:incoming>wa_f10</bpmn:incoming>
      <bpmn:outgoing>wa_f11</bpmn:outgoing>
      <bpmn:outgoing>wa_f12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="wa_read_case" name="确认本人有效临时案例（readOwnedCase）">
      <bpmn:documentation>游客 gpc_ / 登录 epc_ 前缀须与主体一致；本人 active 未过期案例为 owned。</bpmn:documentation>
      <bpmn:incoming>wa_f11</bpmn:incoming>
      <bpmn:outgoing>wa_f13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="wa_gw_case" name="案例归本人？">
      <bpmn:incoming>wa_f13</bpmn:incoming>
      <bpmn:outgoing>wa_f14</bpmn:outgoing>
      <bpmn:outgoing>wa_f15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="wa_end_case_404" name="404 NOT_FOUND">
      <bpmn:incoming>wa_f14</bpmn:incoming>
      <bpmn:errorEventDefinition id="wa_end_case_404_error_def" errorRef="wa_error_404_not_found" />
    </bpmn:endEvent>
    <bpmn:task id="wa_read_plant" name="读取植物上下文与最近浇水事实（仅登录用户）">
      <bpmn:documentation>游客请求长期植物 → 400；readPlantContext（档案实测盆、品种绑定、档案版本）与 readLatestWateringFact；服务端值覆盖品种、盆器与上次浇水。</bpmn:documentation>
      <bpmn:incoming>wa_f12</bpmn:incoming>
      <bpmn:outgoing>wa_f16</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="wa_gw_plant" name="植物可用？">
      <bpmn:incoming>wa_f16</bpmn:incoming>
      <bpmn:outgoing>wa_f17</bpmn:outgoing>
      <bpmn:outgoing>wa_f18</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="wa_end_plant_reject" name="400 游客 / 404 / 409 归档 / 503">
      <bpmn:incoming>wa_f17</bpmn:incoming>
      <bpmn:errorEventDefinition id="wa_end_plant_reject_error_def" errorRef="wa_error_404_user_plant_not_found_or_archived" />
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="wa_gw_target_merge" name="">
      <bpmn:incoming>wa_f15</bpmn:incoming>
      <bpmn:incoming>wa_f18</bpmn:incoming>
      <bpmn:outgoing>wa_f19</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="wa_read_policy" name="读取活动浇水策略 care/mvp_watering">
      <bpmn:documentation>readWateringPolicy(capturedAt)：无可用发布为 null（结果为暂不可用，不是错误）。</bpmn:documentation>
      <bpmn:incoming>wa_f19</bpmn:incoming>
      <bpmn:outgoing>wa_f20</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="wa_read_baseline" name="读取 Tropicals 名义基线（硬规则 v1）">
      <bpmn:documentation>readPlantBaseline(catalogTaxonRef)；无品种或不受支持为 null。</bpmn:documentation>
      <bpmn:incoming>wa_f20</bpmn:incoming>
      <bpmn:outgoing>wa_f21</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="wa_gw_reads" name="读取成功？">
      <bpmn:incoming>wa_f21</bpmn:incoming>
      <bpmn:outgoing>wa_f22</bpmn:outgoing>
      <bpmn:outgoing>wa_f23</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="wa_end_reads_503" name="503 SERVICE_UNAVAILABLE">
      <bpmn:incoming>wa_f22</bpmn:incoming>
      <bpmn:errorEventDefinition id="wa_end_reads_503_error_def" errorRef="wa_error_503_service_unavailable" />
    </bpmn:endEvent>
    <bpmn:task id="wa_window" name="计算 Open-Meteo 查询窗口（回看≤92天，预报16天）">
      <bpmn:documentation>resolveOpenMeteoRequestWindow：回看起点为盆土观察、上次浇水、Lux 读数中最早者。</bpmn:documentation>
      <bpmn:incoming>wa_f23</bpmn:incoming>
      <bpmn:outgoing>wa_f24</bpmn:outgoing>
    </bpmn:task>
    <bpmn:serviceTask id="wa_fetch" name="获取并标准化 Open-Meteo 辐射">
      <bpmn:documentation>fetchRadiation；Provider 失败或异常时 radiation=null（光照缺段，流程继续，仍返回 200）。</bpmn:documentation>
      <bpmn:incoming>wa_f24</bpmn:incoming>
      <bpmn:outgoing>wa_f25</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:businessRuleTask id="wa_light" name="光照锚点 → 植物位置 PPFD 时段序列" camunda:decisionRef="mvp_decision_plant_light_anchor">
      <bpmn:documentation>deriveMvpPlantLightIntervals：PPFD(h)=Lux 换算区间×GHI(h)÷GHI(测量时段)；测量后 24 小时内附室内实测 VPD。策略或辐射缺失时不计算，环境时段为空。</bpmn:documentation>
      <bpmn:incoming>wa_f25</bpmn:incoming>
      <bpmn:outgoing>wa_f35</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:businessRuleTask id="wa_light_response" name="光响应 L(q)=q/(q+75)，相对 qref=50" camunda:decisionRef="mvp_decision_light_response">
      <bpmn:documentation>逐时段，TypeScript 计算；超出 PPFD 0～1500 为缺段。</bpmn:documentation>
      <bpmn:incoming>wa_f35</bpmn:incoming>
      <bpmn:outgoing>wa_f36</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:businessRuleTask id="wa_vpd" name="VPD 包络（Dref=1.4、s=0.6，含区间内峰值；无实测用 0.7～2.2）" camunda:decisionRef="mvp_decision_vpd_envelope">
      <bpmn:documentation>逐时段，TypeScript 计算；超出 VPD 0.1～4 为缺段。</bpmn:documentation>
      <bpmn:incoming>wa_f36</bpmn:incoming>
      <bpmn:outgoing>wa_f37</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:businessRuleTask id="wa_retention" name="栽培干燥倍率：盆体积比＋主要材料可用水 → S / P / Ae" camunda:decisionRef="mvp_decision_cultivation_retention">
      <bpmn:documentation>deriveCultivationDrying（v3，合同 §8）：实际内盆对参考盆 15/11/13cm 的体积比与土表面积比（留空 1、3cm 两端取包络），基质可用水按主要材料规则混合；S=v×AW÷0.3，P=v^[0,0.52]，Ae=土表面积比。几何不全/装不了土/未选基质，以及 v1/v2：S=0.8～1.25、P=Ae=1。盆壁蒸发 κ 未纳入（待验证票 z8v0kmvewm）。</bpmn:documentation>
      <bpmn:incoming>wa_f37</bpmn:incoming>
      <bpmn:outgoing>wa_f38</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:businessRuleTask id="wa_demand" name="环境需水强度：0.8×L×H×P＋0.2×D/1.4×Ae" camunda:decisionRef="mvp_decision_environment_demand">
      <bpmn:documentation>任一分量缺段 → 该时段从干燥时段清单丢弃。</bpmn:documentation>
      <bpmn:incoming>wa_f38</bpmn:incoming>
      <bpmn:outgoing>wa_f39</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:businessRuleTask id="wa_progress" name="缺段补齐（v3，≤6h）与逐时段干燥进度累积、检查窗口" camunda:decisionRef="mvp_decision_drying_progress">
      <bpmn:documentation>fillMvpDryingGaps：v3 起两个有效时段之间 ≤6h 的空洞用有效域全区间需求补齐（首段之前、预报终点之后不补）。rate=[Demand_pot.min÷S.max, Demand_pot.max÷S.min]，进度 += rate×时长÷24h；补齐后仍有空洞 → 历史为 history_gap、未来停止覆盖。</bpmn:documentation>
      <bpmn:incoming>wa_f39</bpmn:incoming>
      <bpmn:outgoing>wa_f40</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:businessRuleTask id="wa_build" name="浇水决策与公开结果（MVP 浇水决策）" camunda:decisionRef="mvp_decision_public_result">
      <bpmn:documentation>assessMvpWatering 其余步骤：湿度分组、盆土有效期与映射、本轮窗口、安全门、盆器安全、行动、水量与公开结果；buildWateringAdvice 另组装输入清单、算法发布清单与派生摘要。以上 7 步均为纯计算，不访问网络或数据库。</bpmn:documentation>
      <bpmn:incoming>wa_f40</bpmn:incoming>
      <bpmn:outgoing>wa_f26</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="wa_gw_persist" name="持久化分支？">
      <bpmn:incoming>wa_f26</bpmn:incoming>
      <bpmn:outgoing>wa_f27</bpmn:outgoing>
      <bpmn:outgoing>wa_f28</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="wa_txn_case" name="事务：幂等占位→锁案例→查建会话→追加结果→读回">
      <bpmn:documentation>createWateringAdviceApplicationService：会话与结果期限等于案例期限；暂不可用结果同样追加；不写浇水事实、计划或提醒。</bpmn:documentation>
      <bpmn:incoming>wa_f27</bpmn:incoming>
      <bpmn:outgoing>wa_f29</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="wa_txn_plant" name="事务：幂等占位→锁本人植物→复核指纹→写结果与建议">
      <bpmn:documentation>createUserPlantWateringAdviceApplicationService：404/409 归档；档案版本、品种绑定、最近浇水事实任一变化 → 回滚 503；可确认结果同事务写 care_proposals。</bpmn:documentation>
      <bpmn:incoming>wa_f28</bpmn:incoming>
      <bpmn:outgoing>wa_f30</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="wa_gw_persist_merge" name="">
      <bpmn:incoming>wa_f29</bpmn:incoming>
      <bpmn:incoming>wa_f30</bpmn:incoming>
      <bpmn:outgoing>wa_f31</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="wa_gw_txn" name="事务结果？">
      <bpmn:incoming>wa_f31</bpmn:incoming>
      <bpmn:outgoing>wa_f32</bpmn:outgoing>
      <bpmn:outgoing>wa_f33</bpmn:outgoing>
      <bpmn:outgoing>wa_f34</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="wa_end_txn_409" name="404 / 409 拒绝">
      <bpmn:documentation>同键异体 409 IDEMPOTENCY_CONFLICT；事务内案例/植物不存在 404、归档 409（作为首次结果记录，可重放）。</bpmn:documentation>
      <bpmn:incoming>wa_f32</bpmn:incoming>
      <bpmn:errorEventDefinition id="wa_end_txn_409_error_def" errorRef="wa_error_409_idempotency_conflict_or_not_found" />
    </bpmn:endEvent>
    <bpmn:endEvent id="wa_end_txn_503" name="503 处理中 / 提交未知">
      <bpmn:documentation>首个请求未完成、提交结果未知且只读对账未命中、或指纹变化：客户端用同一幂等键重试。</bpmn:documentation>
      <bpmn:incoming>wa_f33</bpmn:incoming>
      <bpmn:errorEventDefinition id="wa_end_txn_503_error_def" errorRef="wa_error_503_service_unavailable_retry" />
    </bpmn:endEvent>
    <bpmn:endEvent id="wa_end_ok" name="200 浇水建议（含首次结果重放）">
      <bpmn:incoming>wa_f34</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="wa_f01" sourceRef="wa_start" targetRef="wa_limits" />
    <bpmn:sequenceFlow id="wa_f02" sourceRef="wa_limits" targetRef="wa_gw_limits" />
    <bpmn:sequenceFlow id="wa_f03" name="否" sourceRef="wa_gw_limits" targetRef="wa_end_413_415" />
    <bpmn:sequenceFlow id="wa_f04" name="是" sourceRef="wa_gw_limits" targetRef="wa_principal" />
