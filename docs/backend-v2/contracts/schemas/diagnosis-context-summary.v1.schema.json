{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qinghuazhi.local/contracts/diagnosis-context-summary.v1.schema.json",
  "title": "诊断上下文摘要 v1（内部合同）",
  "description": "GET /api/v2/internal/user-plants/{userPlantRef}/diagnosis-context 的响应体。由 user-plant 域生成的「事实摘要」，供 diagnosis 服务端拼入视觉诊断提示词的可变尾部。最多 12 条、每条 ≤40 字（合计约 600 tokens 以内）；只含城市级位置，不含坐标、地址、昵称或用户自由文本；症状出现时间等追问信息不属于本合同。用户 2026-10-10 裁定冻结；只冻结合同，未实现。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "caseKind",
    "generatedAt",
    "facts"
  ],
  "properties": {
    "contractVersion": {
      "const": "diagnosis-context-summary/v1",
      "description": "合同版本。"
    },
    "caseKind": {
      "enum": [
        "long_term_plant",
        "temporary_case"
      ],
      "description": "长期植物或临时案例；临时案例只允许有限事实键。"
    },
    "generatedAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,3})?Z$",
      "description": "摘要生成时间（UTC）。"
    },
    "facts": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "$ref": "#/$defs/fact"
      },
      "description": "按重要性排序的事实摘要；缺失事实可省略或以 valueZh=「未知」表达，由服务端拼装时补「未知」。"
    }
  },
  "allOf": [
    {
      "if": {
        "type": "object",
        "properties": {
          "caseKind": {
            "const": "temporary_case"
          }
        },
        "required": [
          "caseKind"
        ]
      },
      "then": {
        "type": "object",
        "properties": {
          "facts": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "key": {
                  "enum": [
                    "plant_identity",
                    "encyclopedia_needs",
                    "placement",
                    "recent_radiation",
                    "climate_profile"
                  ]
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "valueZh",
        "observedAt",
        "ageDays",
        "reliability",
        "freshness"
      ],
      "properties": {
        "key": {
          "enum": [
            "plant_identity",
            "encyclopedia_needs",
            "pot_and_drainage",
            "substrate",
            "placement",
            "recent_light",
            "watering_history",
            "soil_observation",
            "watering_advice",
            "plan_status",
            "recent_radiation",
            "climate_profile"
          ],
          "description": "闭集事实键；新增键须发布新合同版本。"
        },
        "valueZh": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "not": {
            "type": "string",
            "pattern": "[0-9]{1,3}\\.[0-9]{3,}"
          },
          "description": "≤40 字中文事实摘要；不得包含经纬度等精确位置。"
        },
        "observedAt": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,3})?Z$"
            },
            {
              "type": "null"
            }
          ],
          "description": "事实记录时间；气候态等无时间的事实为 null。"
        },
        "ageDays": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ],
          "description": "距今天数。"
        },
        "reliability": {
          "enum": [
            "user_entered",
            "user_confirmed",
            "system_derived",
            "third_party"
          ],
          "description": "可信度来源。"
        },
        "freshness": {
          "enum": [
            "fresh",
            "stale",
            "unknown"
          ],
          "description": "按事实类型有效期判定的时效；有效期属待配置项。"
        }
      }
    }
  }
}
