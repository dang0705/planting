{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qinghuazhi.local/contracts/diagnosis-visual-api.v1.schema.json",
  "title": "生成式视觉诊断接口 v1（请求与响应 DTO）",
  "description": "diagnosis-visual-api/v1：只限登录用户；每次最多 3 张图；结果复用 diagnosis-result/v2。只冻结合同，未实现。",
  "$defs": {
    "UploadTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cloudPath",
        "allowedMimeTypes",
        "maxImageBytes"
      ],
      "properties": {
        "cloudPath": {
          "type": "string",
          "pattern": "^diagnosis/usr_[A-Za-z0-9_-]{8,60}/visual/[0-9]{6}/[0-9a-f]{32}$",
          "description": "本次可用的云存储路径（不含扩展名）：diagnosis/{本人用户公开编号}/visual/{yyyyMM}/{32 位随机十六进制}；前端追加 .jpg/.png/.webp 后上传"
        },
        "allowedMimeTypes": {
          "type": "array",
          "items": {
            "enum": [
              "image/jpeg",
              "image/png",
              "image/webp"
            ]
          },
          "description": "配置目录 storage.upload.allowed_mime_types"
        },
        "maxImageBytes": {
          "type": "integer",
          "minimum": 1,
          "description": "配置目录 storage.upload.max_image_bytes"
        }
      }
    },
    "UploadTargetsResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "targets"
      ],
      "properties": {
        "targets": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/UploadTarget"
          }
        }
      }
    },
    "RegisterVisualDiagnosisImagesRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "files"
      ],
      "properties": {
        "files": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "fileId"
            ],
            "properties": {
              "fileId": {
                "type": "string",
                "minLength": 10,
                "maxLength": 512,
                "pattern": "^cloud://",
                "description": "小程序上传返回的云文件 ID；服务端校验目录归属、类型与大小，不信任客户端声明的尺寸"
              }
            }
          }
        }
      }
    },
    "RegisteredImage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "imageRef",
        "status"
      ],
      "properties": {
        "imageRef": {
          "type": "string",
          "pattern": "^dvi_[A-Za-z0-9_-]{8,60}$"
        },
        "status": {
          "enum": [
            "registered"
          ]
        }
      }
    },
    "RegisterVisualDiagnosisImagesResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "images"
      ],
      "properties": {
        "images": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/RegisteredImage"
          }
        }
      }
    },
    "CreateVisualDiagnosisRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject",
        "imageRefs"
      ],
      "properties": {
        "subject": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "userPlantRef"
              ],
              "properties": {
                "userPlantRef": {
                  "type": "string",
                  "pattern": "^upl_[A-Za-z0-9_-]{8,60}$"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "ephemeralCaseRef"
              ],
              "properties": {
                "ephemeralCaseRef": {
                  "type": "string",
                  "pattern": "^epc_[A-Za-z0-9_-]{8,60}$"
                }
              }
            }
          ],
          "description": "归属二选一：本人用户植物，或本人登录后的临时案例（是否开放临时案例待裁决）"
        },
        "imageRefs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^dvi_[A-Za-z0-9_-]{8,60}$"
          },
          "description": "已登记且属于本人的图片，最多 3 张（diagnosis.visual.max_images）"
        },
        "userQuestionZh": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "用户描述；只作症状线索，不作为指令"
        }
      }
    },
    "VisualDiagnosisSessionResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "visualDiagnosisRef",
        "status",
        "createdAt"
      ],
      "properties": {
        "visualDiagnosisRef": {
          "type": "string",
          "pattern": "^vds_[A-Za-z0-9_-]{8,60}$"
        },
        "status": {
          "enum": [
            "processing",
            "completed",
            "released_no_charge",
            "failed_no_charge"
          ],
          "description": "processing 处理中；completed 已完成并按实际成本扣点；released_no_charge 非植物/图片不可用，已释放预占；failed_no_charge 模型失败或安全门两次拒绝，已释放预占"
        },
        "createdAt": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,3})?Z$"
        },
        "completedAt": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,3})?Z$"
        },
        "result": {
          "$ref": "https://qinghuazhi.local/contracts/diagnosis-result.v2.schema.json"
        },
        "releaseReason": {
          "enum": [
            "not_plant",
            "image_unusable",
            "model_failed",
            "safety_gate_rejected"
          ]
        },
        "chargedPoints": {
          "type": "integer",
          "minimum": 0,
          "maximum": 23,
          "description": "本次实际扣除的 AI 点数（不超过成本策略预估点数）"
        },
        "retakeAdviceZh": {
          "type": "string",
          "maxLength": 200
        }
      },
      "allOf": [
        {
          "if": {
            "type": "object",
            "properties": {
              "status": {
                "const": "completed"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "type": "object",
            "required": [
              "result",
              "chargedPoints",
              "completedAt"
            ],
            "properties": {
              "result": true,
              "chargedPoints": true,
              "completedAt": true
            }
          }
        },
        {
          "if": {
            "type": "object",
            "properties": {
              "status": {
                "enum": [
                  "released_no_charge",
                  "failed_no_charge"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "type": "object",
            "required": [
              "releaseReason",
              "chargedPoints"
            ],
            "properties": {
              "releaseReason": true,
              "chargedPoints": {
                "type": "integer",
                "const": 0
              }
            }
          }
        }
      ]
    },
    "VisualDiagnosisListItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "visualDiagnosisRef",
        "status",
        "createdAt"
      ],
      "properties": {
        "visualDiagnosisRef": {
          "type": "string",
          "pattern": "^vds_[A-Za-z0-9_-]{8,60}$"
        },
        "status": {
          "enum": [
            "processing",
            "completed",
            "released_no_charge",
            "failed_no_charge"
          ]
        },
        "createdAt": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,3})?Z$"
        },
        "titleZh": {
          "type": "string",
          "maxLength": 40
        },
        "userPlantRef": {
          "type": "string",
          "pattern": "^upl_[A-Za-z0-9_-]{8,60}$"
        }
      }
    },
    "VisualDiagnosisListResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "items"
      ],
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/VisualDiagnosisListItem"
          }
        },
        "nextCursor": {
          "type": "string",
          "maxLength": 200
        }
      }
    }
  }
}
