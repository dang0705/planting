{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "plant-encyclopedia-display/v1",
  "title": "植物百科展示型内容",
  "description": "仅用于公开展示的植物简介、外观、分布和一至三条简短问答；不承载分类学权威、养护、安全或诊断事实。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "introduction",
    "appearance",
    "distribution",
    "qa"
  ],
  "properties": {
    "introduction": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "\\S",
      "description": "面向用户的简短展示介绍。"
    },
    "appearance": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300,
      "pattern": "\\S",
      "description": "只描述可用于展示的外观概览。"
    },
    "distribution": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300,
      "pattern": "\\S",
      "description": "只描述面向用户的分布概览。"
    },
    "qa": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "question",
          "answer"
        ],
        "properties": {
          "question": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "\\S",
            "description": "简短的展示型问题。"
          },
          "answer": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300,
            "pattern": "\\S",
            "description": "简短的展示型回答。"
          }
        }
      },
      "description": "一至三条简短的展示型问答。"
    }
  }
}
