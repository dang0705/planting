{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/miniprogram-e2e/suite.manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["suiteVersion", "id", "leaves"],
  "properties": {
    "suiteVersion": { "const": 1 },
    "id": { "type": "string", "minLength": 1 },
    "leaves": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "module"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "module": { "type": "string", "minLength": 1 },
          "fixtures": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          },
          "config": {
            "type": "object"
          }
        }
      }
    }
  }
}
